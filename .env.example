# Copy to .env. Everything is optional.
# ICPQ_ADMIN_EMAIL=you@company.com
# ICPQ_ADMIN_PASSWORD=change-me-please   (else a one-time setup code is printed in the log)
# ICPQ_THREADS=4                        companies researched in parallel per run
# ICPQ_SECURE_COOKIES=1                 set when served over HTTPS
# ICPQ_SECRET_SEARCH_SERPER=...         keys can come from the environment instead of the Settings page
# ICPQ_LOG_LEVEL=INFO
# ICPQ_NO_AUTH=1                        single-user local mode: no sign-in (only honoured when ICPQ_HOST is localhost)
